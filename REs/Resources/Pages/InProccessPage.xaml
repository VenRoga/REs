<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="REs.Resources.Pages.InProccessPage"
             xmlns:l="clr-namespace:REs.Resources.ViewModels"
             x:DataType="l:InProccessVM"
             Title="In Process Tasks">

    <Grid>
        <Image Source="background_for_main_page.png" Aspect="AspectFill" />
        <Border Grid.Column="0"
        BackgroundColor="#E608111A" 
        StrokeShape="RoundRectangle 24" 
        Padding="15" 
        WidthRequest="450"
        VerticalOptions="Center">
            <Grid RowDefinitions="Auto, Auto, *"
          Padding="20"
          RowSpacing="15">

                <Label Grid.Row="0"
               Text="In Process Tasks"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
                       TextColor="White"/>

                <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="#800000"
               FontSize="13"
               HorizontalOptions="Center"
               IsVisible="{Binding ErrorMessage, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}" />

                <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadTasksCommand}">

                    <CollectionView ItemsSource="{Binding Tasks}"
                EmptyView="No tasks in process"
                ItemsLayout="VerticalList">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="l:TaskListItemVM">
                                <Grid Margin="0,8" HorizontalOptions="Center">
                                    <Border WidthRequest="360"          
                                HorizontalOptions="Center"
                        Padding="14"
                        StrokeThickness="2"
                        Stroke="#000000"
                        BackgroundColor="{Binding DeadlineColor}"
                        StrokeShape="RoundRectangle 14">

                                        <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, Auto"
                          ColumnSpacing="10"
                          RowSpacing="6">

                                            <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White" />

                                            <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding DeadlineText}"
                               FontSize="14"
                               TextColor="White"
                               VerticalOptions="Center" />

                                            <Label Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding Id, StringFormat='Task #{0}'}"
                               FontSize="12"
                               TextColor="#EFFFFFFF" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>
        </Border>
    </Grid> 
</ContentPage>