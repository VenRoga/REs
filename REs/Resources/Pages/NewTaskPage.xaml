<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:l="clr-namespace:REs.Resources.ViewModels"            
             xmlns:s="clr-namespace:REs.Resources.Styles"
             x:Class="REs.Resources.Pages.NewTaskPage"
             x:DataType="l:NewTaskVM"
             Title="New Task">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <s:StylesForApp/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Image Source="background_for_main_page.png" Aspect="AspectFill" />

        <Border HorizontalOptions="Center" 
            VerticalOptions="Center"
            BackgroundColor="#E608111A" 
            StrokeShape="RoundRectangle 24" 
            Padding="30,25"
            WidthRequest="400">

            <VerticalStackLayout Spacing="20" HorizontalOptions="Fill">

                <Label Text="Create New Task" 
                   FontSize="28" 
                   TextColor="{StaticResource MutedText}"
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

                <Grid ColumnDefinitions="*,*" 
      RowDefinitions="Auto"
      ColumnSpacing="12"
      Margin="0">

                    <!-- Первый элемент (Entry) -->
                    <Border Grid.Column="0"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            Stroke="{StaticResource CardOutline}"
            BackgroundColor="#0DFFFFFF"
            Padding="16,12"
            HeightRequest="52">
                        <Entry Text="{Binding TaskName, Mode=TwoWay}"
               Placeholder="Task Name"
               PlaceholderColor="#5A6E75"
               TextColor="#FFFFFF"
               FontSize="16"
               VerticalOptions="Center"
               IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"/>
                    </Border>

                    <!-- Второй элемент (DatePicker) -->
                    <Border Grid.Column="1"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            Stroke="{StaticResource CardOutline}"
            BackgroundColor="#0DFFFFFF"
            Padding="16,12"
            HeightRequest="52">
                        <DatePicker Date="{Binding EndTime, Mode=TwoWay}"
                    Format="dd.MM.yyyy"
                    TextColor="#FFFFFF"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"/>
                    </Border>

                </Grid>

                <Label Text="{Binding ErrorMessage}"
                   TextColor="#FF4B4B"
                   FontSize="12"
                   HorizontalOptions="Center"
                   IsVisible="{Binding ErrorMessage, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}"/>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#38BDF8"
                               HeightRequest="30"
                               HorizontalOptions="Center"/>

                <Border Style="{StaticResource MenuButtonStyle}"
                    Opacity="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}, ConverterParameter=0.5}">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior HoveredBackgroundColor="#30FFFFFF" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CreateTaskCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Style="{StaticResource MenuLabelStyle}" 
                       Text="Create" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>
                </Border>

                <Border Style="{StaticResource MenuButtonStyle}">
                    <Border.Behaviors>
                        <toolkit:TouchBehavior HoveredBackgroundColor="#30FFFFFF" />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToInProccessCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Style="{StaticResource MenuLabelStyle}" 
                       Text="Cancel" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>