<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:l="clr-namespace:REs.Resources.ViewModels"            
             xmlns:s="clr-namespace:REs.Resources.Styles"
             x:Class="REs.Resources.Pages.NewTaskPage"
             x:DataType="l:NewTaskVM"
             Title="New Task">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <s:StylesForApp/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Image Source="background_for_main_page.png" Aspect="AspectFill" />

        <ScrollView>
            <VerticalStackLayout Margin="20,40,20,20" Spacing="20">

                <Label Text="Create New Task"
                       TextColor="White"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Task Name"
                           TextColor="{StaticResource MutedText}"
                           FontSize="14"/>

                    <Entry Placeholder="Enter task name..."
                           PlaceholderColor="{StaticResource MutedText}"
                           Text="{Binding TaskName}"
                           BackgroundColor="#30FFFFFF"
                           TextColor="White"
                           MaxLength="100"
                           FontSize="16">
                        <Entry.Behaviors>
                            <toolkit:MaxLengthReachedBehavior />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmpty}}"
                       FontSize="12"/>
                <Button Text="Create Task"
                        Command="{Binding CreateTaskCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding IsBusy}"
                                     Value="True">
                            <Setter Property="Text" Value="Creating..."/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                   IsRunning="{Binding IsBusy}"
                                   Color="White"/>

                <BoxView HeightRequest="1"
                         BackgroundColor="#30FFFFFF"
                         Margin="0,20"/>

                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Border Style="{StaticResource MenuButtonStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToInProccessCommand}" />
                        </Border.GestureRecognizers>
                        <Label Style="{StaticResource MenuLabelStyle}"
                               Text="In Process"/>
                    </Border>

                    <Border Style="{StaticResource MenuButtonStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToCompletedCommand}" />
                        </Border.GestureRecognizers>
                        <Label Style="{StaticResource MenuLabelStyle}"
                               Text="Completed"/>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>