<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REs.Resources.Styles.StylesForApp">


    <Color x:Key="CardOutline">#2D3D4A</Color>
    <Color x:Key="MutedText">#8A9A9F</Color>

    <Style TargetType="Border" x:Key="MenuButtonStyle">
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,15" />
        <Setter Property="BackgroundColor" Value="#10FFFFFF" />
        <Setter Property="Stroke" Value="{StaticResource CardOutline}" />
        <Setter Property="WidthRequest" Value="180" />
    </Style>

    <Style TargetType="Label" x:Key="MenuLabelStyle">
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Style.Triggers>
            <DataTrigger TargetType="Label">
                <Setter Property="TextColor" Value="#08111A" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


</ResourceDictionary>